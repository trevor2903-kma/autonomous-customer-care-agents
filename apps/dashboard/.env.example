# Dashboard env (Next.js). Copy thành .env.local nếu backend KHÔNG ở localhost:8000.
# (.env.local bị gitignore.) Mặc định trong code đã trỏ localhost:8000.
# Lưu ý: biến NEXT_PUBLIC_* được "bake" lúc build — đổi xong phải build lại.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/chat

# Production (FE & backend KHÁC site, vd Vercel + Render): đặt URL backend ở đây → `/api/*` được proxy qua domain
# dashboard, cookie auth thành cookie bên thứ nhất (Safari/iOS chặn cookie bên thứ ba → 401 sau đăng nhập).
# Khi đặt biến này, NEXT_PUBLIC_API_BASE_URL bị bỏ qua; NEXT_PUBLIC_WS_URL vẫn phải trỏ THẲNG backend (wss://…).
# API_PROXY_TARGET=https://your-backend.onrender.com
